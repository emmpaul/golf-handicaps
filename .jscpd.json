{
  "threshold": 0,
  "minTokens": 50,
  "path": ["src", "tests"],
  "ignore": [
    "**/node_modules/**",
    "**/migrations/**",
    "**/drizzle/**",
    "src/components/ui/**",
    "src/app/globals.css",
    "tests/fixtures/**"
