{
  "name": "golf-handicaps",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emmpaul/golf-handicaps"
  },
  "homepage": "https://github.com/emmpaul/golf-handicaps#readme",
  "bugs": {
    "url": "https://github.com/emmpaul/golf-handicaps/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,worker --prefix-colors blue,magenta \"next dev\" \"pnpm dev:worker\"",
    "dev:worker": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/worker.ts",
    "build": "next build && pnpm build:worker",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --target=node24 --format=cjs --external:better-sqlite3 --external:sharp --outfile=.next/standalone/worker.js",
    "start": "next start",
    "check:pins": "tsx scripts/check-pins.ts",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:compose": "playwright test --config playwright.compose.config.ts",
    "jscpd": "jscpd",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "ocr:debug": "tsx scripts/ocr-debug.ts",
    "ocr:templates": "tsx scripts/ocr-templates.ts"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@base-ui/react": "1.9.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shadcn": "4.22.0",
    "sharp": "0.35.5",
    "thinking-orbs": "0.3.2",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jscpd": "5.4.1",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
